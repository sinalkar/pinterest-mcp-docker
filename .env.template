# ==============================================================================
# Pinterest MCP Server Configuration Template
# Copy this file to .env and fill in your credential values.
# ==============================================================================

# -- Transport Settings --------------------------------------------------------
# Mode: 'stdio' (default), 'http', 'sse' (deprecated HTTP+SSE compatibility
# surface), or 'http+sse' (both HTTP surfaces on one listener)
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8080
MCP_PATH=/mcp
# Only used when MCP_TRANSPORT is 'sse' or 'http+sse'
# MCP_SSE_PATH=/sse
# MCP_MESSAGE_PATH=/messages/

# Required when any HTTP-based transport binds a non-loopback host: set one
# of these two, never both (they are mutually exclusive).
# MCP_AUTH_TOKEN=your_secure_bearer_token
# MCP_OAUTH_ISSUER=https://issuer.example.com
# MCP_OAUTH_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# MCP_RESOURCE_URL=https://mcp.example.com/mcp
# MCP_OAUTH_REQUIRED_SCOPES=mcp:tools

# -- Streamable-HTTP options (default values shown reproduce prior behavior) --
# MCP_JSON_RESPONSE=false
# MCP_STATELESS=false
# MCP_RESUMABILITY=false
# MCP_EVENT_STORE_MAX_EVENTS=1000
# MCP_MAX_REQUEST_BYTES=4194304
# MCP_SESSION_IDLE_TIMEOUT=
# MCP_SSE_RETRY_INTERVAL_MS=

# -- Transport security and CORS ------------------------------------------
# MCP_DNS_REBINDING_PROTECTION=true
# Comma-separated. Defaults to the loopback set when MCP_HOST is loopback,
# otherwise empty (no cross-origin access, no relaxed host checking).
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=
# MCP_CORS_ALLOW_CREDENTIALS=false

# -- Logging Settings ----------------------------------------------------------
# Level: CRITICAL, ERROR, WARNING, INFO, DEBUG
LOG_LEVEL=INFO
# Format: 'text' or 'json'
LOG_FORMAT=text

# -- Pinterest OAuth 2.0 Credentials ------------------------------------------
PINTEREST_CLIENT_ID=your_client_id
PINTEREST_CLIENT_SECRET=your_client_secret

# Optional: pre-populated tokens if bypassing OAuth CLI flow
# PINTEREST_ACCESS_TOKEN=your_access_token
# PINTEREST_REFRESH_TOKEN=your_refresh_token

# -- Storage & Egress Security -------------------------------------------------
# Token storage location (default: $XDG_STATE_HOME/pinterest-mcp/token.json)
# PINTEREST_TOKEN_PATH=/home/app/.local/state/pinterest-mcp/token.json

# Local directory allowed for image_path (default: user home directory)
# PINTEREST_ALLOWED_IMAGE_DIR=/home/app

# Allow local file paths in HTTP transport mode (default: false)
# PINTEREST_ALLOW_LOCAL_PATHS=false

# Max image size limit in bytes (default: 10485760 = 10MB)
# PINTEREST_MAX_IMAGE_BYTES=10485760

# HTTP outbound timeout in seconds (default: 30.0)
# PINTEREST_HTTP_TIMEOUT=30.0
